# --- build artifacts ---
*.o
*.a
*.so
*.lib
*.dylib
*.obj

# --- python (legacy generator) ---
__pycache__/
*.pyc

# --- dub build cache (keep dub.json / dub.selections.json) ---
.dub/

# --- reggae build cache + outputs (regenerable from reggaefile.d) ---
.reggae-build/
.reggae/
.build/
/build
# ...and what the same two binaries are called on Windows, plus what its linker leaves beside
# them. Untracked, they made every report header on that machine say DIRTY.
/build.exe
/build.ilk
/build.pdb
/bin/

# --- generated bindings: produced on demand by `xiboca` / reggae, never committed ---
generated/

# --- compiled binaries (regenerable) ---
/xiboca/xiboca
/xiboca/xiboca.exe
/xiboca/xiboca.pdb
/xiboca/xiboca.lock
/bootstrap/hello
compile_commands.json
/dub.selections.json

# xwin downloads the MSVC CRT and the Windows SDK into ITS WORKING DIRECTORY. Run it from
# outside the checkout (see tools/win/cross-preflight.sh); this keeps an accident out of the tree.
.xwin-cache/

# A NATIVE TOOL LEAVES ITS EXECUTABLE BESIDE ITS SOURCE ON WINDOWS: lupdate-d builds in place, and
# `.exe`/`.pdb` are exactly the pair the linker writes. Untracked, they make `git status --porcelain`
# non-empty, and the test report's own header then stamps every record execution on that machine
# `DIRTY` — about a tree whose only difference from the commit is build output.
/tools/lupdate/*.exe
/tools/lupdate/*.pdb
